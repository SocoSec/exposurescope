# ---- ExposureScope environment variables ----
# Copy this file to `.env.local` for local development, and set the same
# variables in the Vercel dashboard (Project → Settings → Environment Variables)
# for production. NEVER commit real keys to git.

# Anthropic API key — powers the attribute-inference analysis.
# Get one at https://console.anthropic.com/  (Settings → API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for inference. Any current Claude API model string works.
# Sensible default balances quality and cost. Override if you like.
ANTHROPIC_MODEL=claude-sonnet-5

# Have I Been Pwned API key — OPTIONAL.
# Required ONLY for the email breach-lookup feature (Section 03).
# Without it, that section stays disabled and the rest of the app works.
# A paid key is required by HIBP for email/domain lookups: https://haveibeenpwned.com/API/Key
# NOTE: enabling live email lookups on a public deployment means you are
# processing personal data — do this only under an approved ethics protocol.
HIBP_API_KEY=
