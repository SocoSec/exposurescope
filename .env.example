# ---- Exposio environment variables ----
# Local development: copy to `.env.local` (git-ignored). With only the three
# DEV lines at the bottom set, the full flow works offline with fixture data.
# Production: set these in Vercel → Project → Settings → Environment Variables.
# NEVER commit real keys.

# ── Required in production ─────────────────────────────────────────────────
# Signs every verification / scan / report token. Generate: openssl rand -hex 32
# Rotating it instantly invalidates all tokens in flight (harmless: users re-verify).
EXPOSIO_SECRET=

# Verification emails (https://resend.com). The FROM address must be on a domain
# you have verified in Resend — the shared test sender only reaches your own inbox.
RESEND_API_KEY=
EXPOSIO_FROM_EMAIL=Exposio <verify@your-domain.example>

# ── Breach sources (at least one) ──────────────────────────────────────────
# Have I Been Pwned — paid key: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=
# DeHashed — returns raw leaked records; get a legal opinion before enabling
# on a public deployment. Email lookups only.
DEHASHED_API_KEY=
# DEHASHED_USERNAME is NOT used and must NOT be set. It belonged to the retired
# v1 API; v2 only accepts the DeHashed-Api-Key header, and sending Basic auth
# instead makes every lookup fail with a misleading 'key rejected'.

# ── ExpoBot (optional — without it the vetted action plan still works) ─────
ANTHROPIC_API_KEY=
# Small, fast model: replies are short and constrained to the playbook.
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Abuse protection (recommended) ─────────────────────────────────────────
# Shared rate-limit store (https://upstash.com, Redis REST). Without it limits
# are per server instance and the daily caps are approximate.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Daily ceilings across all users — your cost circuit breaker.
EXPOSIO_DAILY_SCAN_CAP=300
EXPOSIO_DAILY_CHAT_CAP=1500

# ── Shown on /privacy (leave empty until you have them) ────────────────────
EXPOSIO_CONTACT_EMAIL=
EXPOSIO_ETHICS_REF=

# ── Testing switches: local development and PREVIEW deployments only ──────
# Ignored on production (VERCEL_ENV=production), whatever they are set to.
# Whenever either is on, the interface says so on screen.
# Use them to demo the whole flow before paying for email / breach-data accounts.
# EXPOSIO_DEMO=1        example breach data instead of HIBP/DeHashed
#                       (clean@example.com returns "no breaches")
# EXPOSIO_SHOW_CODE=1   show the verification code on screen instead of emailing it

# SMS for the phone path (Twilio). All three are required; without them the
# phone tab returns phone_unavailable, so a deployment never gains the ability
# to look up phone numbers merely by being redeployed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# SMS costs money per message, so the phone path has its own daily ceiling.
EXPOSIO_DAILY_SMS_CAP=100
